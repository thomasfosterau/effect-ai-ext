{
  "name": "@thomasfosterau/effect-evals",
  "version": "0.5.0",
  "description": "An Effect-native LLM evaluation toolkit — goldens, scorers, thresholds, metrics (G-Eval, RAG, retrieval ranking: nDCG / recall / MRR / precision@k), a caching runner, and a CLI for *.eval.ts suites.",
  "keywords": [
    "ai",
    "effect",
    "eval",
    "evals",
    "evaluation",
    "g-eval",
    "information-retrieval",
    "llm",
    "llm-as-judge",
    "ndcg",
    "rag",
    "ranking",
    "retrieval",
    "scorer",
    "testing"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-ai-ext/tree/trunk/packages/effect-evals#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ai-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ai-ext.git",
    "directory": "packages/effect-evals"
  },
  "bin": {
    "effect-evals": "./bin/effect-evals.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
