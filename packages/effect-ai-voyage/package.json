{
  "name": "@thomasfosterau/effect-ai-voyage",
  "version": "0.3.2",
  "description": "Effect AI provider for Voyage AI — EmbeddingModel and RerankerModel implementations over Voyage's embeddings and rerank APIs.",
  "keywords": [
    "effect",
    "ai",
    "voyage",
    "embeddings",
    "reranker",
    "rerank"
  ],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "homepage": "https://github.com/thomasfosterau/effect-ai-ext/tree/trunk/packages/effect-ai-voyage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ai-ext.git",
    "directory": "packages/effect-ai-voyage"
  },
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ai-ext/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "dependencies": {
    "@thomasfosterau/effect-ai-ext": "workspace:*"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
