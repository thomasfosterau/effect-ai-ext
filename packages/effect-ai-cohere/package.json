{
  "name": "@thomasfosterau/effect-ai-cohere",
  "version": "0.1.0",
  "description": "Effect AI provider for Cohere — LanguageModel (Command chat), EmbeddingModel, RerankerModel, and ClassifierModel over Cohere's v2 API.",
  "keywords": ["effect", "ai", "cohere", "llm", "language-model", "embedding", "reranker", "classifier"],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "homepage": "https://github.com/thomasfosterau/effect-ai-ext/tree/main/packages/effect-ai-cohere#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ai-ext.git",
    "directory": "packages/effect-ai-cohere"
  },
  "bugs": { "url": "https://github.com/thomasfosterau/effect-ai-ext/issues" },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "src", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.99"
  },
  "dependencies": {
    "@thomasfosterau/effect-ai-ext": "workspace:*"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
