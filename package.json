{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-ai-ext-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @thomasfosterau/effect-ai-* package family — idiomatic extensions to Effect's AI packages.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "changeset": "changeset",
    "changeset:version": "changeset version && vp fmt",
    "changeset:publish": "vp run -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
