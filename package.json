{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-ai-ext-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @thomasfosterau/effect-ai-* package family — idiomatic extensions to Effect's AI packages.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "engines": {
    "node": ">=22.15",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript",
    "check": "pnpm -r --workspace-concurrency=1 run check",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "build": "pnpm -r run build",
    "check:dist": "node scripts/check-dist.mjs",
    "ci": "pnpm run check && pnpm run test && pnpm run build && pnpm run check:dist",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
